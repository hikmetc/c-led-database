{
  "name": "cled-site",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "node scripts/copy-data.mjs",
    "dev": "npm run data && vite dev",
    "build": "npm run data && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test",
    "build:growth": "node scripts/build-growth.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.7",
    "marked": "18.3.0",
    "svelte": "5.59.2",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.19",
    "fzstd": "0.1.1",
    "hyparquet": "1.33.2",
    "minisearch": "7.2.0"
  }
}
